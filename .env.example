# Copiar a .env y completar con valores reales. Nunca commitear .env con datos reales.

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=netcontact

# Autenticación
JWT_SECRET=
ADMIN_PASSWORD=

# Servidor
PORT=3000
FRONTEND_URL=http://localhost:5173

# Integración interna — seguimiento por WhatsApp
# URL base del servicio que expone /api/interno/enviar-mensaje-personalizado.
LEADS_API_URL=
# Clave compartida del servicio interno de FUTURA.
INTERNAL_FUTURA_KEY=

# Google Sheets — copia operativa de Postulantes (Reclutamiento).
# Desactivado por defecto: MySQL es la única fuente de verdad. Poner "true"
# solo para reactivar explícitamente la sincronización.
GOOGLE_SHEETS_RECLUTAMIENTO_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
